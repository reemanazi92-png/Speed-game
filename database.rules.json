{
  "rules": {
    "games": {
      ".read": "auth != null",
      
      "gameState": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['status', 'roundId'])"
      },

      "answers": {
        "$roundId": {
          "$teamId": {
            ".write": "auth != null",
            "$answerId": {
              ".validate": "newData.hasChildren(['text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0"
            }
          }
        }
      }
    }
  }
}
